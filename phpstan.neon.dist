includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - src
    tmpDir: .build/phpstan/
    excludePaths:
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            message: '#Parameter \#1 \$codepoint of function chr expects int<0, 255>, int given#'
            path: src/Core/Randomizer/CoreRandomizer.php
            reportUnmatched: false
        -
            message: '#Parameter \#1 \$codepoint of function chr expects int<0, 255>, int given#'
            path: src/Core/Replacer/Replacer.php
            reportUnmatched: false
